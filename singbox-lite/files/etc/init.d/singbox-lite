#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

SINGBOX_LITE_ETC="/etc/singbox-lite"
SINGBOX_LITE_CONF="$SINGBOX_LITE_ETC/config.json"
SINGBOX_LITE_ACTIVE="$SINGBOX_LITE_ETC/active.json"
SINGBOX_LITE_LOG="/var/log/singbox-lite/core.log"
SINGBOX_LITE_PID="/var/run/singbox-lite.pid"
SINGBOX_LITE_ACTIVE_HASH="/var/run/singbox-lite.active.hash"
SINGBOX_LITE_MANAGED_CORE="/usr/libexec/singbox-lite/sing-box"

log() {
	mkdir -p "$(dirname "$SINGBOX_LITE_LOG")" 2> /dev/null
	printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$SINGBOX_LITE_LOG" 2> /dev/null
}

# Keep the last N KB of a log file (0 or empty means unlimited). Written without
# eval: the limit is validated as plain digits and passed as a numeric tail arg.
truncate_log() {
	local max_kb log size
	max_kb="$1"
	log="$2"
	[ -f "$log" ] || return 0
	case "$max_kb" in
		''|*[!0-9]*) max_kb=2048 ;;
	esac
	[ "$max_kb" -gt 0 ] 2> /dev/null || return 0
	size="$(wc -c < "$log" 2> /dev/null)" || return 0
	[ "$size" -gt "$((max_kb * 1024))" ] 2> /dev/null || return 0
	if tail -c "$((max_kb * 1024))" "$log" > "$log.tmp" 2> /dev/null; then
		mv "$log.tmp" "$log" 2> /dev/null || rm -f "$log.tmp" 2> /dev/null
	fi
}

core_path() {
	local configured source
	config_load singbox-lite
	config_get source 'main' 'core_source' 'managed'
	config_get configured 'main' 'core_binary'
	if [ -n "$configured" ] && [ -x "$configured" ]; then
		printf '%s' "$configured"
		return 0
	fi
	if [ "$source" = "system" ] && [ -x "/usr/bin/sing-box" ]; then
		printf '%s' "/usr/bin/sing-box"
		return 0
	fi
	if [ -x "$SINGBOX_LITE_MANAGED_CORE" ]; then
		printf '%s' "$SINGBOX_LITE_MANAGED_CORE"
		return 0
	fi
	printf '%s' "/usr/bin/sing-box"
}

boot() {
	local enabled
	config_load singbox-lite
	config_get_bool enabled 'main' 'enabled' 0
	[ "$enabled" -eq 1 ] || return 0
	start_service
}

start_service() {
	local start_delay core log_max_kb
	config_load singbox-lite
	config_get start_delay 'main' 'start_delay' 0
	config_get log_max_kb 'main' 'log_max_kb' 2048

	# Logs contain domains/SNI and subscription credentials may appear in
	# errors: keep newly created dirs/files private to root.
	umask 077
	mkdir -p "$SINGBOX_LITE_ETC" /var/log/singbox-lite /var/run
	truncate_log "$log_max_kb" "$SINGBOX_LITE_LOG"

	# Tailscale keeps its node identity and keys here: it must survive reboots
	# and stay readable by root only. Relative paths resolve against -D dir.
	config_get_bool tailscale_enabled 'tailscale' 'enabled' 0
	if [ "$tailscale_enabled" -eq 1 ]; then
		config_get tailscale_state 'tailscale' 'state_directory' '/etc/singbox-lite/tailscale'
		case "$tailscale_state" in
			/*) ;;
			'') tailscale_state="$SINGBOX_LITE_ETC/tailscale" ;;
			*) tailscale_state="$SINGBOX_LITE_ETC/$tailscale_state" ;;
		esac
		mkdir -p "$tailscale_state" 2> /dev/null
		chmod 700 "$tailscale_state" 2> /dev/null
	fi

	if [ "$start_delay" -gt 0 ] 2> /dev/null; then
		sleep "$start_delay"
	fi

	core="$(core_path)"
	if [ ! -x "$core" ]; then
		log "core is not executable: $core"
		return 1
	fi
	if [ ! -f "$SINGBOX_LITE_CONF" ] && [ ! -f "$SINGBOX_LITE_ACTIVE" ]; then
		log "config is missing: $SINGBOX_LITE_CONF"
		return 1
	fi

	# Save/apply separation: config.json is the checked draft; only an explicit
	# start/restart deploys it to active.json, which is what procd runs (and what
	# procd respawns after a crash). A save alone never changes the live config.
	if [ -f "$SINGBOX_LITE_CONF" ]; then
		if ! cp "$SINGBOX_LITE_CONF" "$SINGBOX_LITE_ACTIVE.tmp" 2> /dev/null; then
			log "failed to stage active config: $SINGBOX_LITE_CONF"
			return 1
		fi
		chmod 600 "$SINGBOX_LITE_ACTIVE.tmp" 2> /dev/null
		if ! mv "$SINGBOX_LITE_ACTIVE.tmp" "$SINGBOX_LITE_ACTIVE" 2> /dev/null; then
			log "failed to deploy active config: $SINGBOX_LITE_ACTIVE"
			return 1
		fi
	fi

	if command -v sha256sum > /dev/null 2>&1; then
		sha256sum "$SINGBOX_LITE_ACTIVE" | awk '{print $1}' > "$SINGBOX_LITE_ACTIVE_HASH" 2> /dev/null
	fi

	procd_open_instance singbox-lite
	procd_set_param command /bin/sh -c "exec '$core' -D '$SINGBOX_LITE_ETC' run -c '$SINGBOX_LITE_ACTIVE' >> '$SINGBOX_LITE_LOG' 2>&1"
	procd_set_param file "$SINGBOX_LITE_ACTIVE"
	procd_set_param pidfile "$SINGBOX_LITE_PID"
	procd_set_param respawn 3600 5 5
	procd_set_param reload_signal HUP
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "singbox-lite"
}

stop_service() {
	rm -f "$SINGBOX_LITE_PID" "$SINGBOX_LITE_ACTIVE_HASH" 2> /dev/null
}
