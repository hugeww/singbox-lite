config main 'main'
	option enabled '0'
	option core_source 'managed'
	option core_binary ''
	option core_mirror ''
	option core_version ''
	option auto_update '1'
	option update_interval '6'
	option auto_apply '1'
	option log_level 'info'
	option log_max_kb '2048'
	option start_delay '0'

config inbound 'inbound'
	option address '172.19.0.1/30,fdfe:dcba:9876::1/126'
	option mtu '9000'
	option strict_route '0'
	option exclude_cn '1'

config dns 'dns'
	option mode 'split'
	option strategy 'prefer_ipv4'

config tailscale 'tailscale'
	option enabled '0'
	option auth_key ''
	option hostname ''
	option state_directory '/etc/singbox-lite/tailscale'
	option accept_routes '0'
	option advertise_routes ''
	option advertise_exit_node '0'
	option exit_node ''
	option exit_node_allow_lan_access '0'
	option exit_node_default '0'

config version 'version'
	option plugin_tag ''

config version_core 'version_core'
	option core_tag ''

config panel 'panel'
	option enabled '1'
	option listen '0.0.0.0'
	option port '9090'
	option secret ''
	option dashboard 'official'

config egress 'egress'
	option auto_url 'https://www.gstatic.com/generate_204'
	option auto_interval '10m'
	option auto_tolerance '50'
	option default_group 'auto'
	option us_default ''
	option jp_default ''
	option hk_default ''
	option other_default ''
	option native_default ''
	option native_keywords '原生,原生IP,native,家宽,住宅,residential'
	option us_keywords '美国,US,USA,United States,洛杉矶,圣何塞,西雅图,纽约,芝加哥,达拉斯,硅谷,🇺🇸'
	option jp_keywords '日本,JP,Japan,东京,大阪,埼玉,🇯🇵'
	option hk_keywords '香港,HK,Hong Kong,🇭🇰'

config ruleset 'rs_builtin_cn_ai'
	option kind 'builtin'
	option name '国内 AI'
	option source 'builtin_cn_ai'
	option target 'direct'
	option enabled '1'

config ruleset 'rs_builtin_cn'
	option kind 'builtin'
	option name '国内'
	option source 'builtin_cn'
	option target 'direct'
	option enabled '1'

config ruleset 'rs_builtin_ai'
	option kind 'builtin'
	option name '国外 AI'
	option source 'builtin_ai'
	option target 'default'
	option enabled '1'

config ruleset 'rs_builtin_streaming'
	option kind 'builtin'
	option name '流媒体'
	option source 'builtin_streaming'
	option target 'default'
	option enabled '1'

config ruleset 'rs_builtin_social'
	option kind 'builtin'
	option name '社交'
	option source 'builtin_social'
	option target 'default'
	option enabled '1'

config ruleset 'rs_builtin_dev'
	option kind 'builtin'
	option name '开发'
	option source 'builtin_dev'
	option target 'default'
	option enabled '1'
